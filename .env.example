# The variables the app's tools read. Copy this file to .env, which git ignores; Expo's tools
# read it when they start. Never commit a real value.

# The configuration's environment: a file in config/environments/, such as development.
AI_APP_ENVIRONMENT=development

# Optional: the cloud this build talks to, which replaces the configuration's cloud.address,
# such as https://cloud.example (config/base.toml says what it may be). Unset, the build talks
# to what the configuration names: the simulated cloud, unless config/local.toml names one.
# AI_APP_CLOUD_ADDRESS=
